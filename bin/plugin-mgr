#!/usr/bin/env bash
# Third-party Omarchy plugin inventory, git update checks, and actions.
set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

PLUGINS_DIR="${HOME}/.config/omarchy/plugins"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/omarchy/ultimate-plugin-mgr"
CACHE="${STATE_DIR}/last-check.json"
SCAN_DIR="${STATE_DIR}/scans"
TREE_DIR="${STATE_DIR}/trees"
INSTALL_SCAN_ID="new.install"
SHELL_JSON="${HOME}/.config/omarchy/shell.json"

fail() {
  echo "plugin-mgr: $*" >&2
  exit 1
}

valid_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

usage() {
  cat <<'EOF'
Usage: plugin-mgr <command> [id]

  list              Installed plugins as JSON (merges last git check)
  check [id]        Fetch origin and compare HEAD vs FETCH_HEAD
  enable <id>       omarchy plugin enable
  disable <id>      omarchy plugin disable
  update <id>       omarchy plugin update --yes
  prepare-scan <id> Fetch incoming commits, launch default agent, wait for verdict file
  prepare-install-scan <url>  Clone a git URL and scan before add
  scan-status <id>  Read the security-scan verdict file
  cancel-scan <id>  Drop a pending scan without updating
  add <url>         omarchy plugin add --yes
  remove <id>       omarchy plugin remove --yes
  open <id>         xdg-open the github/repo URL
EOF
}

mkdir -p "$STATE_DIR"

empty_cache() {
  printf '%s\n' '{"checkedAt":0,"plugins":{}}'
}

read_cache() {
  if [[ -f $CACHE ]]; then
    cat "$CACHE"
  else
    empty_cache
  fi
}

write_cache() {
  local tmp
  tmp=$(mktemp "$STATE_DIR/last-check.XXXXXX")
  printf '%s\n' "$1" >"$tmp"
  mv "$tmp" "$CACHE"
}

github_https() {
  local url="${1:-}"
  url="${url%.git}"
  case "$url" in
  git@github.com:*)
    echo "https://github.com/${url#git@github.com:}"
    ;;
  ssh://git@github.com/*)
    echo "https://github.com/${url#ssh://git@github.com/}"
    ;;
  https://github.com/* | http://github.com/* | https://gitlab.com/* | https://codeberg.org/*)
    echo "$url"
    ;;
  *)
    echo "$url"
    ;;
  esac
}

plugin_dir() {
  echo "$PLUGINS_DIR/$1"
}

shell_list() {
  omarchy plugin list --json 2>/dev/null || echo "[]"
}

fallback_ids() {
  [[ -d $PLUGINS_DIR ]] || return 0
  find "$PLUGINS_DIR" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) ! -name '.*' -printf '%f\n' | sort
}

id_enabled_in_shell_json() {
  local id="$1"
  [[ -f $SHELL_JSON ]] || { echo false; return; }
  jq -e --arg id "$id" '
    (.bar.layout.left + .bar.layout.center + .bar.layout.right + .plugins)
    | map(.id // empty) | index($id) != null
  ' "$SHELL_JSON" >/dev/null 2>&1 && echo true || echo false
}

manifest_field() {
  local dir="$1" key="$2"
  local man="$dir/manifest.json"
  [[ -f $man ]] || { echo ""; return; }
  jq -r --arg k "$key" '.[$k] // empty' "$man" 2>/dev/null || true
}

repo_for() {
  local dir="$1"
  local url=""
  if [[ -d $dir/.git ]]; then
    url=$(git -C "$dir" remote get-url origin 2>/dev/null || true)
  fi
  if [[ -z $url ]]; then
    url=$(manifest_field "$dir" repository)
  fi
  if [[ -z $url ]]; then
    url=$(manifest_field "$dir" homepage)
  fi
  github_https "$url"
}

short_sha() {
  local sha="$1"
  if [[ ${#sha} -ge 7 ]]; then
    echo "${sha:0:7}"
  else
    echo "$sha"
  fi
}

one_plugin_json() {
  local id="$1"
  local listed="${2:-}"
  local cache="${3:-}"
  local dir
  dir=$(plugin_dir "$id")

  local name version enabled kinds git repo homepage local_sha remote_sha ahead update check_error first_party
  name=""
  version=""
  enabled=false
  kinds="[]"
  git=false
  first_party=false
  repo=""
  homepage=""
  local_sha=""
  remote_sha=""
  ahead=0
  update=false
  check_error=""

  if [[ -n $listed ]]; then
    name=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .name // empty' <<<"$listed")
    enabled=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .enabled // false' <<<"$listed")
    kinds=$(jq -c --arg id "$id" '.[] | select(.id == $id) | .kinds // []' <<<"$listed")
    first_party=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .firstParty // false' <<<"$listed")
  fi

  if [[ -d $dir ]]; then
    [[ -n $name ]] || name=$(manifest_field "$dir" name)
    version=$(manifest_field "$dir" version)
    homepage=$(manifest_field "$dir" homepage)
    repo=$(repo_for "$dir")
    if [[ -d $dir/.git ]]; then
      git=true
      local_sha=$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)
    fi
  fi

  [[ -n $name ]] || name="$id"
  [[ -n $version ]] || version=""
  [[ -n $kinds ]] || kinds="[]"
  if [[ $enabled != true && $enabled != false ]]; then
    enabled=$(id_enabled_in_shell_json "$id")
  fi
  if [[ $first_party != true ]]; then
    case "$id" in
    omarchy.*) first_party=true ;;
    *) first_party=false ;;
    esac
  fi

  if [[ -n $cache ]]; then
    ahead=$(jq -r --arg id "$id" '.plugins[$id].ahead // 0' <<<"$cache")
    remote_sha=$(jq -r --arg id "$id" '.plugins[$id].remote // empty' <<<"$cache")
    check_error=$(jq -r --arg id "$id" '.plugins[$id].error // empty' <<<"$cache")
    local cached_local
    cached_local=$(jq -r --arg id "$id" '.plugins[$id].local // empty' <<<"$cache")
    if [[ -n $cached_local && -n $local_sha && $cached_local != "$local_sha" ]]; then
      ahead=0
      remote_sha=""
      check_error=""
    fi
  fi
  [[ $ahead =~ ^[0-9]+$ ]] || ahead=0
  if [[ $git == true && $ahead -gt 0 ]]; then
    update=true
  fi

  jq -nc \
    --arg id "$id" \
    --arg name "$name" \
    --arg version "$version" \
    --argjson enabled "$enabled" \
    --argjson kinds "$kinds" \
    --argjson git "$git" \
    --arg repo "$repo" \
    --arg homepage "$homepage" \
    --arg local "$(short_sha "$local_sha")" \
    --arg remote "$(short_sha "$remote_sha")" \
    --argjson ahead "$ahead" \
    --argjson update "$update" \
    --arg checkError "$check_error" \
    --argjson firstParty "$first_party" \
    '{
      id: $id,
      name: $name,
      version: $version,
      enabled: $enabled,
      kinds: $kinds,
      git: $git,
      firstParty: $firstParty,
      repo: $repo,
      homepage: $homepage,
      localCommit: $local,
      remoteCommit: $remote,
      ahead: $ahead,
      updateAvailable: $update,
      checkError: $checkError,
    }'
}

third_party_ids() {
  local listed="$1"
  local ids
  ids=$(jq -r '.[] | select(.firstParty == false) | .id' <<<"$listed" 2>/dev/null || true)
  if [[ -n $ids ]]; then
    printf '%s\n' "$ids"
    return
  fi
  local id
  for id in $(fallback_ids); do
    case "$id" in
    omarchy.*) continue ;;
    *) echo "$id" ;;
    esac
  done
}

all_plugin_ids() {
  local listed="$1"
  local ids
  ids=$(jq -r '.[].id // empty' <<<"$listed" 2>/dev/null || true)
  if [[ -n $ids ]]; then
    printf '%s\n' "$ids"
    return
  fi
  fallback_ids
}

is_first_party() {
  local id="$1"
  local listed="${2:-}"
  if [[ -n $listed ]] && jq -e --arg id "$id" '.[] | select(.id == $id) | .firstParty == true' <<<"$listed" >/dev/null 2>&1; then
    return 0
  fi
  case "$id" in
  omarchy.*) return 0 ;;
  esac
  return 1
}

cmd_list() {
  local listed cache ids id
  listed=$(shell_list)
  cache=$(read_cache)
  ids=$(all_plugin_ids "$listed")
  local items="[]"
  while IFS= read -r id || [[ -n ${id:-} ]]; do
    [[ -n $id ]] || continue
    items=$(jq -c --argjson item "$(one_plugin_json "$id" "$listed" "$cache")" '. + [$item]' <<<"$items")
  done <<<"$ids" || true
  local checkedAt
  checkedAt=$(jq -r '.checkedAt // 0' <<<"$cache")
  [[ $checkedAt =~ ^[0-9]+$ ]] || checkedAt=0
  local agent_info
  agent_info=$(default_agent_info)
  jq -nc --argjson plugins "$items" --argjson checkedAt "$checkedAt" --argjson agent "$agent_info" \
    '{ok: true, checkedAt: $checkedAt, plugins: $plugins} + $agent'
  return 0
}

check_one() {
  local id="$1"
  local dir
  dir=$(plugin_dir "$id")
  valid_id "$id" || fail "invalid plugin id '$id'"
  [[ -d $dir ]] || fail "plugin '$id' is not installed"
  if [[ ! -d $dir/.git ]]; then
    jq -nc --arg id "$id" '{id: $id, git: false, ahead: 0, error: "not a git checkout"}'
    return 0
  fi

  local local_sha remote_sha ahead error
  local_sha=$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)
  remote_sha=""
  ahead=0
  error=""

  local errf
  errf=$(mktemp "$STATE_DIR/fetch.XXXXXX")
  if ! git -C "$dir" fetch --quiet origin HEAD 2>"$errf"; then
    error=$(tr '\n' ' ' <"$errf" | sed 's/[[:space:]]\+/ /g')
    [[ -n $error ]] || error="fetch failed"
  else
    remote_sha=$(git -C "$dir" rev-parse -q FETCH_HEAD 2>/dev/null || true)
    if [[ -n $local_sha && -n $remote_sha ]]; then
      ahead=$(git -C "$dir" rev-list --count HEAD..FETCH_HEAD 2>/dev/null || echo 0)
    fi
  fi
  rm -f "$errf"
  [[ $ahead =~ ^[0-9]+$ ]] || ahead=0

  jq -nc \
    --arg id "$id" \
    --arg local "$local_sha" \
    --arg remote "$remote_sha" \
    --argjson ahead "$ahead" \
    --arg error "$error" \
    '{id: $id, git: true, local: $local, remote: $remote, ahead: $ahead, error: $error}'
}

merge_check() {
  local cache result now
  cache=$(read_cache)
  result="$1"
  now=$(date +%s)
  jq -c --argjson now "$now" --argjson r "$result" '
    .checkedAt = $now
    | .plugins[$r.id] = {
        ahead: $r.ahead,
        local: ($r.local // ""),
        remote: ($r.remote // ""),
        error: ($r.error // "")
      }
  ' <<<"$cache"
}

cmd_check() {
  local listed cache id ids results
  listed=$(shell_list)
  cache=$(read_cache)
  if [[ -n ${1:-} ]]; then
    ids="$1"
  else
    ids=$(third_party_ids "$listed")
  fi
  results="[]"
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    valid_id "$id" || continue
    local dir
    dir=$(plugin_dir "$id")
    [[ -d $dir/.git ]] || continue
    local one
    one=$(check_one "$id")
    cache=$(merge_check "$one")
    write_cache "$cache"
    results=$(jq -c --argjson item "$one" '. + [$item]' <<<"$results")
  done <<<"$ids"
  cmd_list
}

require_id() {
  local id="${1:-}"
  [[ -n $id ]] || fail "plugin id is required"
  valid_id "$id" || fail "invalid plugin id '$id'"
  echo "$id"
}

kinds_of() {
  local id="$1"
  local listed
  listed=$(shell_list)
  jq -r --arg id "$id" '.[] | select(.id == $id) | (.kinds // []) | join(",")' <<<"$listed"
}

cmd_enable() {
  local id listed kinds
  id=$(require_id "${1:-}")
  listed=$(shell_list)
  kinds=$(jq -r --arg id "$id" '.[] | select(.id == $id) | (.kinds // []) | join(",")' <<<"$listed")
  # Omarchy prints "Enabled …" on stdout; the panel only accepts JSON from cmd_list.
  if is_first_party "$id" "$listed"; then
    omarchy plugin enable "$id" >/dev/null
  elif [[ $kinds == *bar-widget* ]]; then
    omarchy plugin enable "$id" --section right >/dev/null
  else
    omarchy plugin enable "$id" >/dev/null
  fi
  cmd_list
}

cmd_disable() {
  local id
  id=$(require_id "${1:-}")
  # Omarchy prints "Disabled …" on stdout; keep stderr for real failures.
  omarchy plugin disable "$id" >/dev/null
  cmd_list
}

fail_json() {
  jq -nc --arg error "$*" '{ok: false, error: $error}'
  exit 0
}

# Queue a user-session restart BEFORE git pull. Omarchy hot-reloads QML as
# soon as files change and kills this Process, so a restart scheduled at the
# end of update never runs. systemd-run --user keeps Hyprland's environment.
schedule_shell_restart() {
  systemctl --user stop plugin-mgr-restart-shell.service plugin-mgr-restart-shell.timer >/dev/null 2>&1 || true
  systemd-run --user --quiet --collect --on-active=4s \
    --unit=plugin-mgr-restart-shell.service \
    /usr/bin/omarchy-restart-shell >/dev/null 2>&1 || true
}

cancel_shell_restart() {
  systemctl --user stop plugin-mgr-restart-shell.service plugin-mgr-restart-shell.timer >/dev/null 2>&1 || true
}

scan_meta_path() { echo "$SCAN_DIR/$1.meta.json"; }
scan_prompt_path() { echo "$SCAN_DIR/$1.prompt"; }
scan_verdict_path() { echo "$SCAN_DIR/$1.json"; }
scan_tree_path() { echo "$TREE_DIR/$1"; }

default_agent_info() {
  local agent has
  agent=$(omarchy-default-agent 2>/dev/null || true)
  agent=${agent//$'\n'/}
  has=false
  if [[ -n $agent ]] && ! omarchy-cmd-missing "$agent"; then
    has=true
  fi
  jq -nc --arg agent "$agent" --argjson has "$has" \
    '{defaultAgent: $agent, hasDefaultAgent: $has}'
}

require_default_agent() {
  local info
  info=$(default_agent_info)
  if [[ $(jq -r '.hasDefaultAgent' <<<"$info") != true ]]; then
    fail_json "no default agent; run: omarchy default agent <name>"
  fi
}

remove_scan_tree() {
  local id="$1"
  local dir plug
  dir=$(scan_tree_path "$id")
  if [[ $id == "$INSTALL_SCAN_ID" ]]; then
    rm -rf "$dir"
    return
  fi
  plug=$(plugin_dir "$id")
  if [[ -d $dir ]]; then
    git -C "$plug" worktree remove --force "$dir" >/dev/null 2>&1 || rm -rf "$dir"
  fi
}

clear_scan_files() {
  local id="$1"
  remove_scan_tree "$id"
  rm -f "$(scan_meta_path "$id")" "$(scan_prompt_path "$id")" "$(scan_verdict_path "$id")"
}

write_scan_prompt() {
  local id="$1" name="$2" repo="$3" local_sha="$4" remote_sha="$5" ahead="$6" worktree="$7" verdict="$8"
  cat <<PROMPT
Security-review this Omarchy shell plugin update before it is installed.

Plugin: ${name} (${id})
Repo: ${repo}
Installed: ${local_sha}
Incoming: ${remote_sha} (${ahead} commit(s) ahead)
Read-only checkout of the incoming tree:
  ${worktree}

Review ONLY security, malware, and data leakage (exfil, secrets, unexpected network, persistence, obfuscated payloads). Ignore correctness and style.

Do not execute anything in that tree. Do not merge, install, or modify ~/.config/omarchy/plugins/${id}.

When finished, write this JSON file (the panel parses only this file, not the terminal):
  ${verdict}

{"verdict":"CLEAR","pluginId":"${id}","remote":"${remote_sha}","summary":"<one line>"}
or
{"verdict":"BLOCK","pluginId":"${id}","remote":"${remote_sha}","summary":"<one line>"}

CLEAR only if nothing dangerous or leaky stands out. If unsure, BLOCK.

Write the JSON file once, then stop. The plugin manager will delete that file and the worktree; that is expected. Do not recreate them.
PROMPT
}

write_install_scan_prompt() {
  local id="$1" name="$2" repo="$3" remote_sha="$4" worktree="$5" verdict="$6"
  cat <<PROMPT
Security-review this Omarchy shell plugin before it is installed for the first time.

Plugin: ${name} (${id})
Repo: ${repo}
Commit: ${remote_sha}
Read-only checkout of the tree:
  ${worktree}

Review ONLY security, malware, and data leakage (exfil, secrets, unexpected network, persistence, obfuscated payloads). Ignore correctness and style.

Do not execute anything in that tree. Do not install it or copy it into ~/.config/omarchy/plugins.

When finished, write this JSON file (the panel parses only this file, not the terminal):
  ${verdict}

{"verdict":"CLEAR","pluginId":"${INSTALL_SCAN_ID}","remote":"${remote_sha}","summary":"<one line>"}
or
{"verdict":"BLOCK","pluginId":"${INSTALL_SCAN_ID}","remote":"${remote_sha}","summary":"<one line>"}

CLEAR only if nothing dangerous or leaky stands out. If unsure, BLOCK.

Write the JSON file once, then stop. The plugin manager will delete that file and the checkout; that is expected. Do not recreate them.
PROMPT
}

cmd_prepare_scan() {
  local id dir listed name repo one error ahead local_sha remote_sha worktree verdict_path prompt_path meta_path prompt agent
  local force=false ref
  id=""
  while (($#)); do
    case "$1" in
    --force) force=true ;;
    *) id=$(require_id "$1") ;;
    esac
    shift
  done
  id=$(require_id "$id")
  dir=$(plugin_dir "$id")
  [[ -d $dir/.git ]] || fail_json "plugin '$id' is not a git checkout"
  listed=$(shell_list)
  if is_first_party "$id" "$listed"; then
    fail_json "refusing to scan first-party plugin '$id'"
  fi
  require_default_agent
  command -v omarchy-agent >/dev/null || fail_json "omarchy-agent is not available"

  mkdir -p "$SCAN_DIR" "$TREE_DIR"
  one=$(check_one "$id")
  write_cache "$(merge_check "$one")"
  error=$(jq -r '.error // empty' <<<"$one")
  [[ -z $error ]] || fail_json "$error"
  ahead=$(jq -r '.ahead // 0' <<<"$one")
  [[ $ahead =~ ^[0-9]+$ ]] || ahead=0
  local_sha=$(jq -r '.local // empty' <<<"$one")
  remote_sha=$(jq -r '.remote // empty' <<<"$one")
  ref=FETCH_HEAD
  if (( ahead <= 0 )); then
    [[ $force == true ]] || fail_json "plugin '$id' has no incoming commits"
    remote_sha=$local_sha
    ref=HEAD
  fi
  [[ -n $remote_sha ]] || fail_json "could not resolve incoming commit for '$id'"

  name=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .name // empty' <<<"$listed")
  [[ -n $name ]] || name=$(manifest_field "$dir" name)
  [[ -n $name ]] || name="$id"
  repo=$(repo_for "$dir")

  clear_scan_files "$id"
  worktree=$(scan_tree_path "$id")
  if ! git -C "$dir" worktree add --detach "$worktree" "$ref" >/dev/null 2>&1; then
    fail_json "could not check out incoming commits for scan"
  fi

  verdict_path=$(scan_verdict_path "$id")
  prompt_path=$(scan_prompt_path "$id")
  meta_path=$(scan_meta_path "$id")
  write_scan_prompt "$id" "$name" "$repo" "$local_sha" "$remote_sha" "$ahead" "$worktree" "$verdict_path" >"$prompt_path"
  jq -nc \
    --arg id "$id" \
    --arg remote "$remote_sha" \
    --arg worktree "$worktree" \
    --arg verdict "$verdict_path" \
    '{id: $id, remote: $remote, worktree: $worktree, verdictPath: $verdict}' >"$meta_path"

  prompt=$(cat "$prompt_path")
  omarchy-agent --prompt "$prompt" >/dev/null 2>&1 &
  disown || true

  jq -nc \
    --arg id "$id" \
    --arg remote "$remote_sha" \
    --arg repo "$repo" \
    --arg worktree "$worktree" \
    --arg verdictPath "$verdict_path" \
    '{ok: true, state: "waiting", id: $id, remote: $remote, repo: $repo, worktree: $worktree, verdictPath: $verdictPath}'
}

cmd_scan_status() {
  local id meta_path verdict_path meta expected got verdict plugin_id summary state
  id=$(require_id "${1:-}")
  meta_path=$(scan_meta_path "$id")
  verdict_path=$(scan_verdict_path "$id")

  if [[ ! -f $meta_path ]]; then
    jq -nc --arg id "$id" '{ok: true, state: "idle", id: $id}'
    return 0
  fi
  meta=$(cat "$meta_path")
  expected=$(jq -r '.remote // empty' <<<"$meta")
  local kind
  kind=$(jq -r '.kind // "update"' <<<"$meta")

  if [[ ! -f $verdict_path ]]; then
    jq -nc --arg id "$id" --arg remote "$expected" --arg kind "$kind" \
      '{ok: true, state: "waiting", id: $id, remote: $remote, kind: $kind}'
    return 0
  fi

  if ! jq -e . "$verdict_path" >/dev/null 2>&1; then
    jq -nc --arg id "$id" --arg summary "invalid scan result" --arg kind "$kind" \
      '{ok: true, state: "block", id: $id, summary: $summary, kind: $kind}'
    return 0
  fi

  plugin_id=$(jq -r '.pluginId // empty' "$verdict_path")
  got=$(jq -r '.remote // empty' "$verdict_path")
  verdict=$(jq -r '.verdict // empty' "$verdict_path" | tr '[:lower:]' '[:upper:]')
  summary=$(jq -r '.summary // empty' "$verdict_path")

  if [[ $plugin_id != "$id" || -z $got || $got != "$expected" ]]; then
    jq -nc --arg id "$id" --arg summary "${summary:-scan result did not match this update}" --arg kind "$kind" \
      '{ok: true, state: "block", id: $id, summary: $summary, kind: $kind}'
    return 0
  fi
  if [[ $verdict == CLEAR ]]; then
    state=clear
    [[ -n $summary ]] || summary="scan clear"
  elif [[ $verdict == BLOCK ]]; then
    state=block
    [[ -n $summary ]] || summary="scan blocked"
  else
    state=block
    summary="invalid scan verdict"
  fi
  jq -nc \
    --arg id "$id" \
    --arg state "$state" \
    --arg remote "$got" \
    --arg summary "$summary" \
    --arg kind "$kind" \
    '{ok: true, state: $state, id: $id, remote: $remote, summary: $summary, kind: $kind}'
}

cmd_cancel_scan() {
  local id
  id=$(require_id "${1:-}")
  clear_scan_files "$id"
  jq -nc --arg id "$id" '{ok: true, state: "idle", id: $id}'
}

cmd_prepare_install_scan() {
  local url id name repo sha worktree verdict_path prompt_path meta_path prompt errf err real_id
  url="${1:-}"
  url="${url//$'\n'/}"
  [[ -n $url ]] || fail_json "git URL is required"
  if command -v omarchy-git-url-check >/dev/null; then
    omarchy-git-url-check "$url" >/dev/null 2>&1 || fail_json "refusing git URL"
  fi
  require_default_agent
  command -v omarchy-agent >/dev/null || fail_json "omarchy-agent is not available"

  id="$INSTALL_SCAN_ID"
  mkdir -p "$SCAN_DIR" "$TREE_DIR"
  clear_scan_files "$id"
  worktree=$(scan_tree_path "$id")
  rm -rf "$worktree"
  errf=$(mktemp "$STATE_DIR/clone.XXXXXX")
  set +e
  git clone --depth 1 -- "$url" "$worktree" >/dev/null 2>"$errf"
  local rc=$?
  set -e
  err=$(tr '\n' ' ' <"$errf" | sed 's/[[:space:]]\+/ /g')
  rm -f "$errf"
  if (( rc != 0 )); then
    rm -rf "$worktree"
    fail_json "${err:-clone failed}"
  fi
  if ! omarchy-plugin-validate "$worktree" >/dev/null 2>&1; then
    rm -rf "$worktree"
    fail_json "plugin validation failed"
  fi
  real_id=$(jq -r '.id // empty' "$worktree/manifest.json")
  name=$(jq -r '.name // empty' "$worktree/manifest.json")
  [[ -n $real_id ]] || { rm -rf "$worktree"; fail_json "manifest has no id"; }
  [[ -n $name ]] || name="$real_id"
  if [[ -d $(plugin_dir "$real_id") ]]; then
    rm -rf "$worktree"
    fail_json "plugin '$real_id' is already installed"
  fi
  sha=$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)
  [[ -n $sha ]] || { rm -rf "$worktree"; fail_json "could not resolve commit"; }
  repo=$(github_https "$url")

  verdict_path=$(scan_verdict_path "$id")
  prompt_path=$(scan_prompt_path "$id")
  meta_path=$(scan_meta_path "$id")
  write_install_scan_prompt "$real_id" "$name" "$repo" "$sha" "$worktree" "$verdict_path" >"$prompt_path"
  jq -nc \
    --arg id "$id" \
    --arg pluginId "$real_id" \
    --arg url "$url" \
    --arg remote "$sha" \
    --arg worktree "$worktree" \
    --arg verdict "$verdict_path" \
    '{id: $id, kind: "install", pluginId: $pluginId, url: $url, remote: $remote, worktree: $worktree, verdictPath: $verdict}' >"$meta_path"

  prompt=$(cat "$prompt_path")
  omarchy-agent --prompt "$prompt" >/dev/null 2>&1 &
  disown || true

  jq -nc \
    --arg id "$id" \
    --arg pluginId "$real_id" \
    --arg url "$url" \
    --arg remote "$sha" \
    --arg worktree "$worktree" \
    --arg verdictPath "$verdict_path" \
    '{ok: true, state: "waiting", kind: "install", id: $id, pluginId: $pluginId, url: $url, remote: $remote, worktree: $worktree, verdictPath: $verdictPath}'
}

cmd_add() {
  local url errf out rc err
  url="${1:-}"
  url="${url//$'\n'/}"
  [[ -n $url ]] || fail_json "git URL is required"
  if command -v omarchy-git-url-check >/dev/null; then
    omarchy-git-url-check "$url" >/dev/null 2>&1 || fail_json "refusing git URL"
  fi
  clear_scan_files "$INSTALL_SCAN_ID"

  errf=$(mktemp "$STATE_DIR/add.XXXXXX")
  set +e
  out=$(omarchy plugin add "$url" --yes --enable 2>"$errf")
  rc=$?
  set -e
  err=$(tr '\n' ' ' <"$errf" | sed 's/[[:space:]]\+/ /g')
  rm -f "$errf"
  if (( rc != 0 )); then
    fail_json "${err:-${out:-add failed}}"
  fi
  cmd_list
}

cmd_update() {
  local id dir errf out rc err
  id=$(require_id "${1:-}")
  dir=$(plugin_dir "$id")
  [[ -d $dir/.git ]] || fail_json "plugin '$id' is not a git checkout"
  clear_scan_files "$id"

  schedule_shell_restart

  errf=$(mktemp "$STATE_DIR/update.XXXXXX")
  set +e
  out=$(omarchy plugin update "$id" --yes 2>"$errf")
  rc=$?
  set -e
  err=$(tr '\n' ' ' <"$errf" | sed 's/[[:space:]]\+/ /g')
  rm -f "$errf"
  if (( rc != 0 )); then
    cancel_shell_restart
    fail_json "${err:-${out:-update failed}}"
  fi

  local sha
  sha=$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)
  cache=$(read_cache)
  cache=$(jq -c --arg id "$id" --arg sha "$sha" --argjson now "$(date +%s)" '
    .checkedAt = $now
    | .plugins[$id] = {ahead: 0, local: $sha, remote: $sha, error: ""}
  ' <<<"$cache")
  write_cache "$cache"

  cmd_list
}

cmd_remove() {
  local id listed
  id=$(require_id "${1:-}")
  listed=$(shell_list)
  if is_first_party "$id" "$listed"; then
    fail "refusing to remove first-party plugin '$id'"
  fi
  omarchy plugin remove "$id" --yes >/dev/null
  cmd_list
}

cmd_open() {
  local id dir url
  id=$(require_id "${1:-}")
  dir=$(plugin_dir "$id")
  url=$(repo_for "$dir")
  [[ -n $url ]] || fail "no repository URL for '$id'"
  xdg-open "$url" >/dev/null 2>&1 &
  jq -nc --arg id "$id" --arg url "$url" '{ok: true, id: $id, url: $url}'
}

cmd="${1:-}"
shift || true
case "$cmd" in
list) cmd_list ;;
check) cmd_check "${1:-}" ;;
enable) cmd_enable "${1:-}" ;;
disable) cmd_disable "${1:-}" ;;
update) cmd_update "${1:-}" ;;
prepare-scan) cmd_prepare_scan "$@" ;;
prepare-install-scan) cmd_prepare_install_scan "${1:-}" ;;
scan-status) cmd_scan_status "${1:-}" ;;
cancel-scan) cmd_cancel_scan "${1:-}" ;;
add) cmd_add "${1:-}" ;;
remove) cmd_remove "${1:-}" ;;
open) cmd_open "${1:-}" ;;
-h | --help | help | "") usage ;;
*) fail "unknown command: $cmd" ;;
esac
